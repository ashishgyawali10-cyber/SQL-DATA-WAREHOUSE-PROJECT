/*
====================================================================================================================
Stored procedure : Load Bronze Layer (source |>  Bronze )
====================================================================================================================
Script purpose :
        This stored procedure loads data into the 'Bronze' schema from external csv files.
        it performs the following action :
        - Truncate the bronze tables before loading data.
        - Uses the BULK INSERT command to load data from csv Files to bronze tables.
  Parameters :
     None.
     This stored procedure does not accept any parameters or return any values.

     Usage example :
       exec bronze.load_bronze;
=====================================================================================================================        

*/

create or alter procedure bronze.load_bronze as 
begin
	declare @start_time datetime , @end_time datetime;
	begin try

			-- inserting the data from .csv files to their respective table
			-- for Bronze.crm_cust_info
			print 'Loading the bronze layer'
			print '==================================================================='
			print 'Loading from crm.csv file'

			set @start_time = getdate();

			TRUNCATE TABLE Bronze.crm_cust_info;
			BULK INSERT Bronze.crm_cust_info
			FROM 'C:\Users\ashis\OneDrive\Desktop\sql files\sql-data-warehouse-project\datasets\source_crm\cust_info.csv'
			WITH (
			firstrow = 2,
			fieldterminator = ',',
			tablock
			);


			-- for Bronze.crm_prd_info
			truncate table Bronze.crm_prd_info;
			 BULK INSERT Bronze.crm_prd_info
			 from 'C:\Users\ashis\OneDrive\Desktop\sql files\sql-data-warehouse-project\datasets\source_crm\prd_info.csv'
			 with (
			 firstrow = 2,
			 fieldterminator =',',
			 tablock
			 );
 
			 -- for Bronze.crm_sales_details
			 truncate table Bronze.crm_sales_details;
			BULK INSERT Bronze.crm_sales_details
			from 'C:\Users\ashis\OneDrive\Desktop\sql files\sql-data-warehouse-project\datasets\source_crm\sales_details.csv'
			with 
			(
			firstrow = 2,
			fieldterminator = ',',
			tablock
			);



			-- for erp sources --
			-- from bronze.erp_cust_az12 --
			print '====================================================' 
			print'Loading from erp.csv file'
			truncate table Bronze.erp_cust_az12;
			bulk insert Bronze.erp_cust_az12
			from 'C:\Users\ashis\OneDrive\Desktop\sql files\sql-data-warehouse-project\datasets\source_erp\CUST_AZ12.csv'
			with 
			(
			firstrow = 2,
			fieldterminator = ',',
			tablock
			);



			--from Bronze.erp_loc_a101
			truncate table Bronze.erp_loc_a101;
			bulk insert Bronze.erp_loc_a101
			from 'C:\Users\ashis\OneDrive\Desktop\sql files\sql-data-warehouse-project\datasets\source_erp\LOC_A101.csv'
			with
			(
			firstrow = 2,
			fieldterminator = ',',
			tablock
			);


			--for Bronze.erp_px_cat_g1v2
			truncate table Bronze.erp_px_cat_g1v2;
			bulk insert Bronze.erp_px_cat_g1v2
			from 'C:\Users\ashis\OneDrive\Desktop\sql files\sql-data-warehouse-project\datasets\source_erp\PX_CAT_G1V2.csv'
			with (
			firstrow = 2,
			fieldterminator=',',
			tablock
			);
			print '========================================='
						set @end_time = getdate();
			print '>> Total load duration:'+ cast (datediff(second, @start_time,@end_time) as nvarchar) +' seconds'
	end try

	

	begin catch
		print '============================================='
		print 'error occred during loding bronze layer'
		print 'error message' + error_message();
		print 'error message' + cast (error_number() as nvarchar);
		print 'error message' + cast (error_state() as nvarchar);
		print '============================================='

	end catch
	
end
